# Copiar este archivo como .env en el servidor real.
# No subir .env a GitHub/Vercel.

PORT=4173
SESSION_TTL_MINUTES=480
SESSION_COOKIE_NAME=ofit_session

# Poner en true SOLO si corres detras de un proxy de confianza (Vercel, Nginx, Cloudflare).
# Si esta en true sin proxy real, se puede falsear la IP y evadir los limites de intentos.
TRUST_PROXY=false

# Dominios permitidos para llamadas al API.
# Ejemplo produccion:
# ALLOWED_ORIGINS=https://ofit-gym.vercel.app,https://ofitgym.com
ALLOWED_ORIGINS=

# Solo se usan cuando se crea data/db.json por primera vez.
# Cambiar antes de publicar.
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=cambiar-admin-antes-de-publicar
DEFAULT_COACH_USER=profe
DEFAULT_COACH_PASSWORD=cambiar-profe-antes-de-publicar
DEFAULT_DEMO_MEMBER_USER=ana
DEFAULT_DEMO_MEMBER_PASSWORD=cambiar-alumno-antes-de-publicar

# Emails transaccionales con Brevo.
# Crear una API key en Brevo y pegarla solo en .env, nunca en el codigo.
BREVO_API_KEY=
MAIL_FROM_NAME=OFIT Gym
MAIL_FROM_EMAIL=market170221@gmail.com
ADMIN_EMAIL=market170221@gmail.com

# Supabase.
# Usar la publishable/anon key aca. Nunca poner SUPABASE_SERVICE_ROLE_KEY en archivos publicos.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu_publishable_key
